{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug debuggee (break in add)",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${workspaceFolder}",
			"env": {
				"BURROW_DEBUG_BREAK": "1"
			}
