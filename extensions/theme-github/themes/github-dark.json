	"semanticTokenColors": {
		"type": "#ffa657",
		"type.defaultLibrary": "#79c0ff",
		"class.defaultLibrary": "#79c0ff",
		"struct": "#ffa657",
		"interface": "#ffa657",
		"function": "#d2a8ff",
		"function.defaultLibrary": "#d2a8ff",
		"method": "#d2a8ff",
		"variable.readonly.defaultLibrary": "#79c0ff",
		"keyword": "#ff7b72"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#8b949e" }
		},
		{
			"scope": ["comment.documentation", "comment.block.documentation"],
			"settings": { "foreground": "#8b949e" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#a5d6ff" }
		},
		{
			"scope": ["constant.character.escape", "constant.other.placeholder"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["constant.numeric", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#ff7b72" }
		},
		{
			"scope": ["constant.language", "variable.language"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["keyword.operator", "punctuation", "meta.brace"],
			"settings": { "foreground": "#e6edf3" }
		},
		{
			"scope": ["entity.name.function", "meta.function-call.generic", "meta.function-call"],
			"settings": { "foreground": "#d2a8ff" }
		},
		{
			"scope": ["support.function"],
			"settings": { "foreground": "#d2a8ff" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "meta.type.name"],
			"settings": { "foreground": "#ffa657" }
		},
		{
			"scope": ["support.type", "support.class", "support.constant", "support.other.namespace"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable", "variable.object.property"],
			"settings": { "foreground": "#e6edf3" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#e6edf3" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
			"settings": { "foreground": "#ff7b72" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#7ee787" }
		},
		{
			"scope": ["support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#79c0ff" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#1f6feb", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#a5d6ff" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#a5d6ff" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#aff5b4" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#ffdcd7" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#ffa198" }
		}
	]
}
