		"dropdown.background": "#ffffff",
		"dropdown.foreground": "#1f2328",
		"dropdown.border": "#d0d7de",
		"badge.background": "#0969da",
		"badge.foreground": "#ffffff",
		"button.background": "#1f883d",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#1a7f37",
		"button.secondaryBackground": "#eff2f5",
		"button.secondaryForeground": "#24292f",
		"button.secondaryHoverBackground": "#e6eaef",
		"list.activeSelectionBackground": "#afb8c133",
		"list.activeSelectionForeground": "#1f2328",
		"list.inactiveSelectionBackground": "#afb8c126",
		"list.inactiveSelectionForeground": "#1f2328",
		"list.hoverBackground": "#afb8c11a",
		"list.focusOutline": "#0969da",
		"list.highlightForeground": "#0969da",
		"scrollbarSlider.background": "#8c959f33",
		"scrollbarSlider.hoverBackground": "#8c959f45",
		"scrollbarSlider.activeBackground": "#8c959f58",
		"progressBar.background": "#0969da",
		"gitDecoration.modifiedResourceForeground": "#9a6700",
		"gitDecoration.addedResourceForeground": "#1a7f37",
		"gitDecoration.deletedResourceForeground": "#cf222e",
		"gitDecoration.untrackedResourceForeground": "#1a7f37",
		"debugToolBar.background": "#ffffff",
		"debugIcon.breakpointForeground": "#cf222e",
		"debugIcon.breakpointCurrentStackframeForeground": "#9a6700",
		"editorGutter.addedBackground": "#1a7f37",
		"editorGutter.modifiedBackground": "#9a6700",
		"editorGutter.deletedBackground": "#cf222e"
	},
	"semanticTokenColors": {
		"type": "#953800",
		"type.defaultLibrary": "#0550ae",
		"class.defaultLibrary": "#0550ae",
		"struct": "#953800",
		"interface": "#953800",
		"function": "#8250df",
		"function.defaultLibrary": "#8250df",
		"method": "#8250df",
		"variable.readonly.defaultLibrary": "#0550ae",
		"keyword": "#cf222e"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#6e7781" }
		},
		{
			"scope": ["comment.documentation", "comment.block.documentation"],
			"settings": { "foreground": "#6e7781" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#0a3069" }
		},
		{
			"scope": ["constant.character.escape", "constant.other.placeholder"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["constant.numeric", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#cf222e" }
		},
		{
			"scope": ["constant.language", "variable.language"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["keyword.operator", "punctuation", "meta.brace"],
			"settings": { "foreground": "#1f2328" }
		},
		{
			"scope": ["entity.name.function", "meta.function-call.generic", "meta.function-call"],
			"settings": { "foreground": "#8250df" }
		},
		{
			"scope": ["support.function"],
			"settings": { "foreground": "#8250df" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "meta.type.name"],
			"settings": { "foreground": "#953800" }
		},
		{
			"scope": ["support.type", "support.class", "support.constant", "support.other.namespace"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable", "variable.object.property"],
			"settings": { "foreground": "#1f2328" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#1f2328" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
			"settings": { "foreground": "#cf222e" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#116329" }
		},
		{
			"scope": ["support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#0550ae" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#0550ae", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#0a3069" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#0a3069" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#116329" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#82071e" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#82071e" }
		}
	]
}
