		"editor.foreground": "#DFDFE0",
		"editorLineNumber.foreground": "#747478",
		"editorLineNumber.activeForeground": "#DFDFE0",
		"editor.selectionBackground": "#646F8359",
		"editor.selectionHighlightBackground": "#646F8333",
		"editor.lineHighlightBackground": "#2F323A",
		"editor.findMatchBackground": "#C9714B80",
		"editor.findMatchHighlightBackground": "#C9714B4D",
		"editorCursor.foreground": "#DFDFE0",
		"editorWhitespace.foreground": "#42444B",
		"editorIndentGuide.background1": "#3A3C44",
		"editorIndentGuide.activeBackground1": "#54565E",
		"editorBracketMatch.background": "#41444C",
		"editorBracketMatch.border": "#5A5D66",
		"editorGutter.background": "#292A30",
