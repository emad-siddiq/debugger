	"semanticTokenColors": {
		"type": "#5DD8FF",
		"struct": "#5DD8FF",
		"interface": "#5DD8FF",
		"typeParameter": "#5DD8FF",
		"function": "#41A1C0",
		"method": "#41A1C0",
		"type.defaultLibrary": "#D0BF69",
		"class.defaultLibrary": "#D0BF69",
		"function.defaultLibrary": "#D0BF69",
		"method.defaultLibrary": "#D0BF69",
		"variable.readonly.defaultLibrary": "#D0BF69",
		"keyword": "#FC5FA3"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#6C7986" }
		},
		{
			"scope": ["comment.documentation", "comment.block.documentation"],
			"settings": { "foreground": "#A3B1C0" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#FC6A5D" }
		},
		{
			"scope": ["constant.character.escape", "constant.other.placeholder"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["constant.numeric", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["constant.language", "variable.language"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["keyword.operator", "punctuation", "meta.brace"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"scope": ["entity.name.function", "meta.function-call.generic", "meta.function-call"],
			"settings": { "foreground": "#41A1C0" }
		},
		{
			"scope": ["support.function"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "meta.type.name"],
			"settings": { "foreground": "#5DD8FF" }
		},
		{
			"scope": ["support.type", "support.class", "support.constant", "support.other.namespace"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable", "variable.object.property"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#99E5FF" }
		},
		{
			"scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
			"settings": { "foreground": "#FFA14A" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#FFFFFF" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#41A1C0", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#FC6A5D" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#64B5F6" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#FF6961" }
		},
		{
			"name": "CSS selectors (source.css). The generic rules above leave a stylesheet nearly monochrome — property names and colors both land on plain-identifier white — so the isolation workbench's stylesheet column gets its own mapping: selector = tag pink, property = type blue, value = system gold, function = call teal, custom property = attribute blue.",
			"scope": ["entity.name.tag.css", "entity.name.tag.custom.css", "entity.name.tag.wildcard.css"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.css"],
			"settings": { "foreground": "#99E5FF" }
		},
		{
			"scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["support.type.property-name.css", "support.type.vendored.property-name.css", "support.type.property-name.media.css", "support.type.vendored.property-name.media.css"],
			"settings": { "foreground": "#5DD8FF" }
		},
		{
			"scope": ["support.constant.property-value.css", "support.constant.vendored.property-value.css", "support.constant.color.w3c-standard-color-name.css", "support.constant.color.w3c-extended-color-name.css", "support.constant.color.current.css", "support.constant.font-name.css", "support.constant.media.css", "constant.other.color.rgb-value.hex.css", "entity.other.keyframe-offset.css", "entity.other.keyframe-offset.percentage.css"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["support.function.calc.css", "support.function.misc.css", "support.function.url.css", "support.function.gradient.css", "support.function.transform.css", "support.function.timing-function.css", "support.function.shape.css"],
			"settings": { "foreground": "#41A1C0" }
		},
		{
			"name": "Custom properties: --brand where it is declared and inside var().",
			"scope": ["variable.css", "variable.argument.css"],
			"settings": { "foreground": "#99E5FF" }
		},
		{
			"name": "The @ of an at-rule, so @media reads as one word.",
			"scope": ["punctuation.definition.keyword.css"],
			"settings": { "foreground": "#FC5FA3" }
		}
	]
}
