		"list.activeSelectionBackground": "#33415E",
		"list.activeSelectionForeground": "#FFFFFF",
		"list.inactiveSelectionBackground": "#2F3239",
		"list.hoverBackground": "#2F3239",
		"list.highlightForeground": "#6BDFFF",
		"scrollbarSlider.background": "#5A5D6640",
		"scrollbarSlider.hoverBackground": "#5A5D6666",
		"scrollbarSlider.activeBackground": "#5A5D6699",
		"progressBar.background": "#3B82F6",
		"gitDecoration.modifiedResourceForeground": "#D9C97C",
		"gitDecoration.addedResourceForeground": "#67B7A4",
		"gitDecoration.deletedResourceForeground": "#FC6A5D",
		"gitDecoration.untrackedResourceForeground": "#67B7A4",
		"debugToolBar.background": "#2A2A2E",
		"debugIcon.breakpointForeground": "#FC6A5D"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#6C7986" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#FC6A5D" }
		},
		{
			"scope": ["constant.character.escape", "constant.other.placeholder"],
			"settings": { "foreground": "#FF8170" }
		},
		{
			"scope": ["constant.numeric", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#D0BF69" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["constant.language", "variable.language", "support.constant"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["keyword.operator", "punctuation", "meta.brace"],
			"settings": { "foreground": "#DFDFE0" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic", "meta.function-call"],
			"settings": { "foreground": "#67B7A4" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "meta.type.name"],
			"settings": { "foreground": "#5DD8FF" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable", "variable.object.property"],
			"settings": { "foreground": "#DFDFE0" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#DFDFE0" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#BF8555" }
		},
		{
			"scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
			"settings": { "foreground": "#FD8F3F" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#FC5FA3" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#67B7A4", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#FF6961" }
		}
	]
}
