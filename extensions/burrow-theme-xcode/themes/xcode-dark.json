		"editorWidget.background": "#2A2A2E",
		"editorSuggestWidget.background": "#2A2A2E",
		"editorSuggestWidget.selectedBackground": "#33415E",
		"editorHoverWidget.background": "#2A2A2E",
		"foreground": "#C8C8CC",
		"focusBorder": "#3B82F6",
		"selection.background": "#3B82F680",
		"widget.shadow": "#00000066",
		"sideBar.background": "#262629",
		"sideBar.foreground": "#C8C8CC",
		"sideBarTitle.foreground": "#A0A0A5",
		"sideBarSectionHeader.background": "#2A2A2E",
		"sideBarSectionHeader.foreground": "#C8C8CC",
		"activityBar.background": "#1F1F24",
		"activityBar.foreground": "#DFDFE0",
		"activityBar.inactiveForeground": "#77777C",
		"activityBarBadge.background": "#3B82F6",
		"activityBarBadge.foreground": "#FFFFFF",
		"statusBar.background": "#1F1F24",
		"statusBar.foreground": "#B0B0B4",
		"statusBar.noFolderBackground": "#1F1F24",
		"statusBar.debuggingBackground": "#8F5A22",
		"statusBar.debuggingForeground": "#FFFFFF",
		"titleBar.activeBackground": "#2A2A2E",
		"titleBar.activeForeground": "#DFDFE0",
		"titleBar.inactiveBackground": "#242427",
		"titleBar.inactiveForeground": "#8E8E93",
		"tab.activeBackground": "#292A30",
		"tab.inactiveBackground": "#242427",
		"tab.activeForeground": "#FFFFFF",
		"tab.inactiveForeground": "#8E8E93",
		"tab.activeBorderTop": "#3B82F6",
		"tab.border": "#1F1F24",
		"editorGroupHeader.tabsBackground": "#242427",
		"editorGroup.border": "#1F1F24",
		"panel.background": "#1F1F24",
		"panel.border": "#1F1F24",
		"panelTitle.activeForeground": "#DFDFE0",
		"panelTitle.inactiveForeground": "#8E8E93",
		"terminal.background": "#292A30",
		"terminal.foreground": "#DFDFE0",
		"terminal.ansiBlack": "#3B3B41",
		"terminal.ansiRed": "#FC6A5D",
		"terminal.ansiGreen": "#67B7A4",
		"terminal.ansiYellow": "#D0BF69",
		"terminal.ansiBlue": "#41A1C0",
		"terminal.ansiMagenta": "#FC5FA3",
		"terminal.ansiCyan": "#5DD8FF",
		"terminal.ansiWhite": "#DFDFE0",
		"terminal.ansiBrightBlack": "#747478",
		"terminal.ansiBrightRed": "#FF8170",
		"terminal.ansiBrightGreen": "#78C2B3",
		"terminal.ansiBrightYellow": "#D9C97C",
		"terminal.ansiBrightBlue": "#4CB0D8",
		"terminal.ansiBrightMagenta": "#FF7AB2",
		"terminal.ansiBrightCyan": "#6BDFFF",
		"terminal.ansiBrightWhite": "#FFFFFF",
		"input.background": "#1F1F24",
		"input.foreground": "#DFDFE0",
		"input.border": "#3A3A3E",
		"dropdown.background": "#1F1F24",
		"dropdown.border": "#3A3A3E",
		"badge.background": "#3B82F6",
		"badge.foreground": "#FFFFFF",
		"button.background": "#3B82F6",
		"button.foreground": "#FFFFFF",
