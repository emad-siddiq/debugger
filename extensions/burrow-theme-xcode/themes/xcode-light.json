		"scrollbarSlider.hoverBackground": "#00000040",
		"scrollbarSlider.activeBackground": "#00000059",
		"progressBar.background": "#0A69DA",
		"gitDecoration.modifiedResourceForeground": "#836C28",
		"gitDecoration.addedResourceForeground": "#326D74",
		"gitDecoration.deletedResourceForeground": "#D12F1B",
		"gitDecoration.untrackedResourceForeground": "#326D74",
		"debugToolBar.background": "#F2F2F5",
		"debugIcon.breakpointForeground": "#D12F1B",
		"debugIcon.breakpointCurrentStackframeForeground": "#836C28",
		"editorGutter.addedBackground": "#3E8087",
		"editorGutter.modifiedBackground": "#836C28",
		"editorGutter.deletedBackground": "#D12F1B"
