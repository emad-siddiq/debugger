{
	"name": "burrow-db",
	"displayName": "Burrow Database Explorer",
	"description": "The Postgres explorer for Burrow (architecture task 10): connect from a setting or DATABASE_URL, browse schemas/tables via information_schema, and run a read-only SELECT into a pandas-style results grid. First slice — connection layer + catalog tree + query-to-grid webview.",
	"version": "0.1.0",
	"publisher": "burrow",
	"license": "MIT",
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:burrowDbExplorer",
		"onCommand:burrow.db.runQuery"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:burrow-db",
		"watch": "gulp watch-extension:burrow-db",
		"test": "node test/dsn.test.js && node test/catalog.test.js && node test/starters.test.js && node test/grid.test.js && node test/pgadminConfig.test.js && node test/workspaceDsn.test.js"
	},
	"contributes": {
		"commands": [
			{
				"command": "burrow.db.runQuery",
				"title": "Run SQL Query…",
				"category": "Burrow DB",
				"icon": "$(play)"
			},
			{
				"command": "burrow.db.refresh",
				"title": "Refresh",
				"category": "Burrow DB",
				"icon": "$(refresh)"
			},
			{
				"command": "burrow.db.openTable",
				"title": "Open Table",
				"category": "Burrow DB"
			},
			{
				"command": "burrow.db.openPgAdmin",
				"title": "Open pgAdmin",
				"category": "Burrow DB",
				"icon": "$(server-environment)"
			},
			{
				"command": "burrow.db.stopPgAdmin",
				"title": "Stop pgAdmin",
				"category": "Burrow DB"
			},
			{
				"command": "burrow.db.tableInfo",
				"title": "Table Info (Columns, Types, Keys)",
				"category": "Burrow DB",
				"icon": "$(list-flat)"
			},
			{
				"command": "burrow.db.starterQuery",
				"title": "Starter Queries…",
				"category": "Burrow DB",
				"icon": "$(bookmark)"
			},
			{
				"command": "burrow.db.toggleWrites",
				"title": "Toggle Session Writes (Read-Only Guard)",
				"category": "Burrow DB",
				"icon": "$(unlock)"
			},
			{
				"command": "burrow.db.seedWorld",
				"title": "Seed the DB",
				"category": "Burrow DB",
				"icon": "$(database)"
			}
		],
		"keybindings": [
			{
				"command": "burrow.db.runQuery",
				"key": "shift+cmd+d",
				"mac": "shift+cmd+d"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "burrow-db",
					"title": "Data",
					"icon": "$(database)"
				}
			]
		},
		"views": {
			"burrow-db": [
				{
					"id": "burrowDbExplorer",
					"name": "Database"
				}
			]
		},
		"menus": {
			"commandPalette": [
				{
					"command": "burrow.db.openTable",
					"when": "false"
				},
				{
					"command": "burrow.db.tableInfo",
					"when": "false"
				},
				{
					"command": "burrow.db.starterQuery",
					"when": "false"
				}
			],
			"view/item/context": [
				{
					"command": "burrow.db.tableInfo",
					"when": "view == burrowDbExplorer && viewItem =~ /^burrowDb\\.(table|view|matview)$/",
					"group": "inline@1"
				},
				{
					"command": "burrow.db.starterQuery",
					"when": "view == burrowDbExplorer && viewItem =~ /^burrowDb\\.(table|view|matview)$/",
					"group": "inline@2"
				}
			],
			"view/title": [
				{
					"command": "burrow.db.starterQuery",
					"when": "view == burrowDbExplorer",
					"group": "navigation@1"
				},
				{
					"command": "burrow.db.refresh",
					"when": "view == burrowDbExplorer",
					"group": "navigation@2"
				},
				{
					"command": "burrow.db.openPgAdmin",
					"when": "view == burrowDbExplorer",
					"group": "1_more@1"
				},
				{
					"command": "burrow.db.toggleWrites",
					"when": "view == burrowDbExplorer",
					"group": "1_more@2"
				},
				{
					"command": "burrow.db.seedWorld",
					"when": "view == burrowDbExplorer",
					"group": "1_more@3"
				}
			]
		},
		"configuration": {
			"title": "Burrow Database Explorer",
			"properties": {
				"burrow.db.connectionString": {
					"type": "string",
					"default": "",
					"markdownDescription": "Postgres connection URL (`postgres://user:pass@host:5432/db`). When empty, Burrow falls back to the `DATABASE_URL` environment variable — the NodeWatch contract means the right database is known once a scheme exists.",
					"tags": [
						"burrow"
					]
				},
				"burrow.db.previewRowLimit": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"description": "Row limit appended to the SELECT that opens when you click a table in the explorer.",
					"tags": [
						"burrow"
					]
				},
				"burrow.db.pgadmin.port": {
					"type": "number",
					"default": 6110,
					"minimum": 1,
					"description": "Loopback port Burrow publishes the managed pgAdmin container on (http://127.0.0.1:<port>).",
					"tags": [
						"burrow"
					]
				},
				"burrow.db.seedProfile": {
					"type": "string",
					"default": "",
					"description": "Path to the target project's seed profile (per-table starter queries and the Seed the DB actions). Empty = the convention infra/seed/seed.json under the workspace root. Relative paths resolve against it.",
					"tags": [
						"burrow"
					]
				}
			}
		},
		"viewsWelcome": [
			{
				"view": "burrowDbExplorer",
				"contents": "No Postgres connection. Burrow discovers one from `burrow.db.connectionString`, `DATABASE_URL`, or the workspace's own `.vscode/launch.json`.\n[Set the connection string](command:workbench.action.openSettings?%22burrow.db.connectionString%22)"
			}
		]
	},
	"dependencies": {
		"pg": "^8.22.0"
	}
}
