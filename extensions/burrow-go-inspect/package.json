{
	"name": "burrow-go-inspect",
	"displayName": "Burrow Go Inspector",
	"description": "The Go value inspector for Burrow: a path-addressed DAP value model with type-aware one-line summaries (WO-3), a constant-depth breadcrumb drill navigator (WO-4), and a Miller-column + value-pane webview prototype (WO-5, architecture task 05.4/05.5). Picking one inspector and retiring the stock tree are the later IX WOs.",
	"version": "0.1.0",
	"publisher": "burrow",
	"license": "MIT",
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Debuggers"
	],
	"activationEvents": [
		"onDebug"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:burrow-go-inspect",
		"watch": "gulp watch-extension:burrow-go-inspect",
		"test": "node test/summary.test.js && node test/literal.test.js"
	},
	"contributes": {
		"commands": [
			{
				"command": "burrow.inspect.home",
				"title": "Inspector: Go to Scopes",
				"category": "Burrow",
				"icon": "$(home)"
			},
			{
				"command": "burrow.inspect.up",
				"title": "Inspector: Back One Level",
				"category": "Burrow",
				"icon": "$(arrow-left)"
			},
			{
				"command": "burrow.inspect.refresh",
				"title": "Refresh Inspector (Preview)",
				"category": "Burrow",
				"icon": "$(refresh)"
			},
			{
				"command": "burrow.inspect.drill",
				"title": "Inspector: Drill Into Value",
				"category": "Burrow"
			}
		],
		"views": {
			"debug": [
				{
					"id": "burrowInspectorPreview",
					"name": "Inspector (Preview)",
					"when": "inDebugMode && debugType == go"
				},
				{
					"id": "burrowInspectorMiller",
					"name": "Inspector (Miller Preview)",
					"type": "webview",
					"when": "inDebugMode && debugType == go"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "burrow.inspect.up",
					"when": "view == burrowInspectorPreview",
					"group": "navigation@1"
				},
				{
					"command": "burrow.inspect.home",
					"when": "view == burrowInspectorPreview",
					"group": "navigation@2"
				},
				{
					"command": "burrow.inspect.refresh",
					"when": "view == burrowInspectorPreview",
					"group": "navigation@3"
				}
			],
			"commandPalette": [
				{
					"command": "burrow.inspect.refresh",
					"when": "inDebugMode && debugType == go"
				},
				{
					"command": "burrow.inspect.home",
					"when": "inDebugMode && debugType == go"
				},
				{
					"command": "burrow.inspect.up",
					"when": "inDebugMode && debugType == go"
				},
				{
					"command": "burrow.inspect.drill",
					"when": "false"
				}
			]
		}
	}
}
