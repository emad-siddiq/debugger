{
	"name": "burrow-go-test",
	"displayName": "Burrow Go Tests",
	"description": "First-class Go tests for Burrow (architecture task 11): a native Test Explorer populated by scanning the workspace for `func Test*`/`Benchmark*`/`Fuzz*`/`Example*`, with real `go test -run <name> -json ./<pkg>` execution reporting pass/fail live into the test UI. First slice — discovery + run; coverage, bench history, fuzz corpus, watch mode and debug come later.",
	"version": "0.1.0",
	"publisher": "burrow",
	"license": "MIT",
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Testing"
	],
	"activationEvents": [
		"onLanguage:go",
		"onView:burrowTests",
		"workspaceContains:**/*_test.go",
		"onWebviewPanel:burrow.test.lab",
		"onCommand:burrow.test.profile",
		"onWebviewPanel:burrowGoProfile"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:burrow-go-test",
		"watch": "gulp watch-extension:burrow-go-test",
		"test": "node test/discovery.test.js && node test/command.test.js && node test/events.test.js && node test/labModel.test.js && node test/coverage.test.js && node test/profileArgs.test.js"
	},
	"contributes": {
		"commands": [
			{
				"command": "burrow.test.refresh",
				"title": "Refresh Go Tests",
				"category": "Burrow",
				"icon": "$(refresh)"
			},
			{
				"command": "burrow.test.openLab",
				"title": "Open the Test Lab",
				"category": "Burrow",
				"icon": "$(screen-full)"
			},
			{
				"command": "burrow.test.runAll",
				"title": "Run Go Tests",
				"category": "Burrow",
				"icon": "$(play)"
			},
			{
				"command": "burrow.test.profile",
				"title": "Profile Package…",
				"category": "Burrow",
				"icon": "$(pulse)"
			}
		],
		"keybindings": [
			{
				"command": "burrow.test.refresh",
				"key": "shift+cmd+t",
				"mac": "shift+cmd+t",
				"when": "editorLangId == go"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "burrow.test.refresh"
				},
				{
					"command": "burrow.test.profile"
				}
			],
			"view/title": [
				{
					"command": "burrow.test.runAll",
					"when": "view == burrowTests",
					"group": "navigation@1"
				},
				{
					"command": "burrow.test.openLab",
					"when": "view == burrowTests",
					"group": "navigation@2"
				},
				{
					"command": "burrow.test.refresh",
					"when": "view == burrowTests",
					"group": "1_more@1"
				}
			],
			"editor/title": [
				{
					"command": "burrow.focus.toggle",
					"when": "activeWebviewPanelId == burrow.test.lab",
					"group": "navigation@100"
				}
			],
			"editor/context": [
				{
					"command": "burrow.test.profile",
					"group": "navigation@97",
					"when": "editorLangId == go"
				}
			]
		},
		"configuration": {
			"title": "Burrow Go Tests",
			"properties": {
				"burrow.test.goExecutable": {
					"type": "string",
					"default": "go",
					"description": "Path to the `go` binary used to discover and run tests.",
					"tags": [
						"burrow"
					]
				},
				"burrow.test.race": {
					"type": "boolean",
					"default": false,
					"description": "Run every test with the race detector (`-race`), honoring the scheme bar's race toggle.",
					"tags": [
						"burrow"
					]
				}
			}
		},
		"views": {
			"burrow-fullstack": [
				{
					"id": "burrowTests",
					"name": "Tests",
					"visibility": "collapsed"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "burrowTests",
				"contents": "No Go tests found. Burrow looks for `func Test*` in `*_test.go` under this workspace.\n[Rescan](command:burrow.test.refresh)"
			}
		]
	}
}
