{
	"name": "burrow-project",
	"displayName": "Burrow Project Spine",
	"description": "What a project IS, and how Burrow works it out (WO-71). Detection first: a folder with a go.mod is a Go project with nothing written. `.burrow/project.json` records only what detection could not infer. Scaffolds a canonical Go project — go.mod, one HTTP route, compose.yaml, .env — in the form Go's own community writes them, so `rm -rf .burrow` leaves a project that still builds.",
	"version": "0.1.0",
	"publisher": "burrow",
	"license": "MIT",
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onTaskType:go"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:burrow-project",
		"watch": "gulp watch-extension:burrow-project",
		"test": "node test/descriptor.test.js && node test/goTemplate.test.js && node test/goTasks.test.js && node test/schemeBar.test.js && node test/toolchain.test.js"
	},
	"contributes": {
		"commands": [
			{
				"command": "burrow.project.create",
				"title": "New Project…",
				"category": "Burrow",
				"icon": "$(new-folder)"
			},
			{
				"command": "burrow.project.addPostgres",
				"title": "Add Postgres to This Project",
				"category": "Burrow",
				"icon": "$(database)"
			},
			{
				"command": "burrow.project.describe",
				"title": "Write the Project Descriptor",
				"category": "Burrow",
				"icon": "$(json)"
			},
			{
				"command": "burrow.project.explain",
				"title": "What Is This Project?",
				"category": "Burrow",
				"icon": "$(question)"
			},
			{
				"command": "burrow.run.start",
				"title": "Run",
				"category": "Burrow",
				"icon": "$(play)"
			},
			{
				"command": "burrow.run.debug",
				"title": "Debug",
				"category": "Burrow",
				"icon": "$(debug-alt)"
			},
			{
				"command": "burrow.run.stop",
				"title": "Stop the Running Program",
				"category": "Burrow",
				"icon": "$(primitive-square)"
			},
			{
				"command": "burrow.run.pick",
				"title": "Choose the Program to Run…",
				"category": "Burrow",
				"icon": "$(target)"
			},
			{
				"command": "burrow.run.toggleRace",
				"title": "Toggle the Race Detector",
				"category": "Burrow",
				"icon": "$(shield)"
			},
			{
				"command": "burrow.toolchain.doctor",
				"title": "Go Toolchain…",
				"category": "Burrow",
				"icon": "$(tools)"
			}
		],
		"taskDefinitions": [
			{
				"type": "go",
				"required": [
					"task"
				],
				"properties": {
					"task": {
						"type": "string",
						"enum": [
							"build",
							"test",
							"vet",
							"generate",
							"tidy",
							"lint"
						],
						"description": "Which Go command to run."
					},
					"packages": {
						"type": "string",
						"description": "Package pattern, e.g. ./... or ./internal/ingest. Ignored by `tidy`, which accepts no arguments.",
						"default": "./..."
					}
				}
			}
		],
		"problemMatchers": [
			{
				"name": "go",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-backend",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/backend"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-server",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/server"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-api",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/api"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-cmd",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/cmd"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-src",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/src"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			},
			{
				"name": "go-service",
				"owner": "go",
				"source": "go",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/service"
				],
				"pattern": {
					"regexp": "^(?:vet: |-: )?(?:\\.\\/)?(\\S+\\.go):(\\d+):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"message": 4
				}
			}
		]
	}
}
