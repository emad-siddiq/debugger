{
  "name": "frontend-debugger",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A visual React component debugger: embed a target app, drill from parent to leaf components in theater mode, inspect CSS + breakpoints + source, and save edits back to disk with live HMR.",
  "scripts": {
    "build": "vite build --config ui/vite.config.ts",
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "serve": "NODE_ENV=production node server/index.js",
    "oracle": "node .claude/oracle/oracle.mjs",
    "verify": "node test/verify.mjs",
    "controls": "node test/isolationControls.mjs",
    "unit": "node --test test/isolateHarness.test.mjs test/conditionalStates.test.mjs",
    "sweep": "node test/renderSweep.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.25.9",
    "express": "^4.21.1",
    "postcss": "^8.4.47"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "monaco-editor": "^0.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "zustand": "^4.5.5"
  }
}
